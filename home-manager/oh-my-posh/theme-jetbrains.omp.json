{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
	    {
          "background": "#343B4A",
          "foreground": "#E2E8F0",
          "style": "powerline",
          "template": "{{ if .WSL }}WSL at{{ end }} {{.Icon}} ",
          "type": "os"
        },
		{
          "background": "#252B45",
          "foreground": "#80D8FF",
          "options": {
            "time_format": "15:04"
          },
          "style": "diamond",
          "template": " {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "\ue0b0",
          "type": "time"
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#3B4261",
          "foreground": "#E0E7FF",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}v{{ .Full }}{{ end }}{{ end }} "
        },
	    {
		  "type": "python",
		  "style": "diamond",
		  "powerline_symbol": "\ue0b0",
		  "background": "#7048A8",
          "foreground": "#FFFFFF",
          "trailing_diamond": "\ue0b0",
          "template": " {{ if hasPrefix \"lu-etat-fi-\" .Venv }}{{ regexReplaceAll \"-py[0-9]+\\\\.[0-9]+$\" (trimPrefix \"lu-etat-fi-\" .Venv) \"\" }}{{ else }}{{ .Venv }}{{ end }} "
        },
        {
          "background": "#176B68",
          "foreground": "#E6FFFA",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " {{ .AbsolutePWD }} ",
          "type": "path"
        },
        {
          "background": "#8A5A24",
          "foreground": "#FFF3D6",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "type": "node"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}